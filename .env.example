# Base URL of the single-company API (everything except /health and /ready lives under /api/v1).
# Use a relative path together with VITE_API_PROXY_TARGET in dev to avoid CORS.
VITE_API_BASE_URL=/api/v1

# Dev only: Vite proxies /api/* to this origin.
VITE_API_PROXY_TARGET=http://localhost:3000

# Shown in the sidebar and on the sign-in screen.
VITE_APP_NAME=Car Rental Admin
